{
  "name": "comunicacao-maquinas",
  "version": "1.0.0",
  "description": "Aplicacao para comunicacao TCP/IP com maquinas",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/copyAssets.cjs",
    "build:win": "npm run build && electron-builder --win portable --x64",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test scripts/test*.cjs",
    "test:tcp": "npm run build && node --test scripts/testTcp.cjs",
    "test:api": "npm run build && node --test scripts/testApi.cjs",
    "test:pcm": "npm run build && node --test scripts/testPcmEntry.cjs",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/database/migrateMysql.cjs",
    "test:inspection": "npm run build && node --test scripts/testInspection.cjs",
    "start:api": "npm run build && node --env-file-if-exists=.env dist/api/server.js",
    "start": "npm run build && electron .",
    "dev": "npm run start"
  },
  "build": {
    "appId": "br.com.conecthus.pcm",
    "productName": "PCM IHM",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PCM-IHM-${version}-${arch}.exe"
    }
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.5.1",
    "@types/swagger-ui-express": "^4.1.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
