API_HOST=127.0.0.1
API_PORT=3000
# MongoDB: preencher para habilitar o registro de entrada da linha.
# Valores abaixo já servem para o container Docker (docker-compose.yml).
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=pcm
MONGO_USER=pcm_app
MONGO_PASSWORD=pcm_app
# Usadas apenas pelo container MongoDB (usuário root), não pela aplicação.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root
# KAFKA_PORT: porta publicada pelo container Kafka (docker-compose.yml).
# Deve casar com a porta usada em KAFKA_BROKERS abaixo.
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=pcm.serial-numbers
KAFKA_CLIENT_ID=pcm-serial-api
# KAFKA_CONSUMER_GROUP_ID: usada só por src/kafka/consumer.ts. Padrão pcm-kafka-consumer.
# KAFKA_CONSUMER_GROUP_ID=pcm-kafka-consumer
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
